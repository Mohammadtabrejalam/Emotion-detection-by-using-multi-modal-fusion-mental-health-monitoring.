# ===================================================================
# MINDSENSE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.development and fill in your secrets.
# NEVER commit real credentials to version control.
# ===================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (PostgreSQL / SQLite fallback)
# Production PostgreSQL example: postgresql://user:password@localhost:5432/mindsense
DATABASE_URL=sqlite:///./backend/app/mindsense.db

# Cryptographic & Session Secrets
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary Media Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
