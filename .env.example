# Copy to .env at the repository root. The backend loads this file.
ENVIRONMENT=development
# REQUIRED in production: generate with python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=
MINDSENSE_DATABASE_PATH=./data/mindsense.db
MINDSENSE_MODELS_DIR=./models
MINDSENSE_PRELOAD_MODELS=0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional password reset / developer verification email. TLS is mandatory.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=mindsense@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
